<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Garita</string>
    <key>CFBundleDisplayName</key>
    <string>Garita</string>
    <key>CFBundleIdentifier</key>
    <string>local.garita</string>
    <key>CFBundleExecutable</key>
    <string>Garita</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>15.0</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>es</string>
    <!-- Clic derecho en el Finder → "Escanear con Garita" (ver ServicioFinder.swift).
         NSMessage es el nombre del método que recibe los archivos;
         public.item abarca cualquier archivo o carpeta. -->
    <key>NSServices</key>
    <array>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Escanear con Garita</string>
            </dict>
            <key>NSMessage</key>
            <string>escanearConGarita</string>
            <key>NSPortName</key>
            <string>Garita</string>
            <key>NSSendFileTypes</key>
            <array>
                <string>public.item</string>
            </array>
            <key>NSRequiredContext</key>
            <dict/>
        </dict>
    </array>
    <!-- Sin icono en el Dock: la app vive solo en la barra de menú. -->
    <key>LSUIElement</key>
    <true/>
</dict>
</plist>
